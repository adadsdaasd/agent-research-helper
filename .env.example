# GitHub Scout MCP Server 配置示例
# 复制此文件为 .env 并填入你的配置

# ============== GitHub API ==============
# GitHub Token (可选，用于提高 API 速率限制)
# 在 https://github.com/settings/tokens 生成 Personal Access Token
GITHUB_TOKEN=

# ============== LLM API (可选) ==============
# 配置后可启用智能模式（LLM 语义分析）
# 支持多种 LLM 提供商，按优先级自动检测

# === MiniMax ===
# 官网: https://www.minimaxi.com/
# 获取 Key: https://platform.minimaxi.com/
MINIMAX_API_KEY=sk-cp-keT3aa1s5Fa1ix-NIAW_OKG5Un8xsmtn1XuCgBbjdMJhk1ynfyyHdugRfkuzbDjDUHkWSEgezLzJWm-uFTPYbtgiS2fnnV8TSNi3_LRizYPcN1c1_yxSsP8
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-Text-01

